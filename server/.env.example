NODE_ENV=development
PORT=5000

# Frontend origins allowed by CORS, separated by commas
# Local development:
CORS_ORIGINS=http://localhost:3500
# Production example:
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_CREDENTIALS=false

# MongoDB Connection
# Para MongoDB Atlas (recomendado para producción):
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/tempora_db
# O para MongoDB local:
# MONGODB_URI=mongodb://localhost:27017/tempora_db

# JWT Configuration
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA_Y_LARGA_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRE=30d

# Local DNS workaround. It is always disabled when NODE_ENV=production.
USE_CUSTOM_DNS=true
DNS_SERVERS=8.8.8.8,1.1.1.1

# Gold market data
GOLD_API_URL=https://api.gold-api.com/price/XAU
GOLD_REQUEST_TIMEOUT_MS=5000
GOLD_CACHE_TTL_MS=30000
GOLD_FALLBACK_PRICE_USD=3389.30
